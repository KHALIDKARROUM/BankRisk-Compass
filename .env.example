# Copy this file to the uncommitted .env file (chmod 600) or inject these values
# from your deployment secret manager. Do not put secrets in Compose or Git.
DEBUG=False
# At least 50 random characters.
SECRET_KEY=
# Fernet keys; generate each independently with Fernet.generate_key().
FIELD_ENCRYPTION_KEY=
# Rotation: active write key first, followed by old read-only keys.
FIELD_ENCRYPTION_KEYS=
# At least 32 random characters.
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEYS=
# Base64-encoded 32-byte Ed25519 public key.
MODEL_SIGNING_PUBLIC_KEY=
BACKUP_ENCRYPTION_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
LOGIN_REQUIRED=True
# Aegis-Credit is deliberately single-tenant: set a stable opaque identifier
# for this lender's dedicated deployment/database. Required when DEBUG=False.
DEPLOYMENT_TENANT_ID=
SECURE_SSL_REDIRECT=True
# Enable only behind a proxy that strips and sets X-Forwarded-Proto itself.
TRUST_X_FORWARDED_PROTO=True

# Use PostgreSQL for shared or production deployments.
POSTGRES_DB=aegis_credit
POSTGRES_USER=aegis_credit
POSTGRES_PASSWORD=
# Use host `database` when this file is consumed by Docker Compose.
DATABASE_URL=
DB_SSL_REQUIRE=True

# Preferred: JSON map of independently rotatable client credentials.
SCORING_API_KEYS={}
# Deprecated compatibility key; exposed internally as client id "legacy".
SCORING_API_KEY=
API_RATE_LIMIT_PER_MINUTE=60
CASE_RETENTION_DAYS=365
ACCESS_LOG_RETENTION_DAYS=365
RETENTION_INTERVAL_SECONDS=86400
MAX_BATCH_ROWS=1000
MAX_UPLOAD_BYTES=10485760
# Bound decompression before parsing an XLSX archive (50 MiB and 2,000 members).
MAX_XLSX_UNCOMPRESSED_BYTES=52428800
MAX_XLSX_ARCHIVE_MEMBERS=2000
CASE_REVIEW_SLA_HOURS=48
CASE_PAGE_SIZE=50
MONITORING_FRESHNESS_HOURS=24
MONITORING_MIN_SAMPLE_SIZE=100
CURRENCY_CODE=
# Keep synchronous processing for development only; production should enqueue.
BATCH_PROCESS_INLINE=False
BATCH_LEASE_SECONDS=300
BATCH_MAX_ATTEMPTS=3

# Uploaded batch files require durable, private storage when jobs are queued.
MEDIA_ROOT=/var/lib/aegis-credit/media
MEDIA_URL=/media/
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage

# This remains False until a real production dataset has completed independent
# provenance review. Never enable it for the included synthetic demonstration data.
DATA_PROVENANCE_VERIFIED=False

# Development only: run.py enables this for the bundled, hash-checked demo
# artifacts. Keep it False in shared and production deployments.
LOCAL_DEMO_MODE=False

# Optional first production administrator. The bootstrap command creates the
# account only when both username and password are supplied.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
